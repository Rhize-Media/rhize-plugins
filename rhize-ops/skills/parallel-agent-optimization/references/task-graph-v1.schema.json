{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhize.media/schemas/task-graph-v1.schema.json",
  "title": "Rhize ephemeral task graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "expected_checkout_fingerprint", "concurrency_budget", "coordinator_slots_reserved", "context_item_budget", "nodes"],
  "properties": {
    "schema_version": {"const": "rhize-task-graph-v1"},
    "expected_checkout_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "concurrency_budget": {"type": "integer", "minimum": 1},
    "coordinator_slots_reserved": {"type": "integer", "minimum": 1},
    "context_item_budget": {"type": "integer", "minimum": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "deliverable", "inputs", "output_contract", "depends_on", "reads", "writes", "resources", "requires_approval", "external_effect", "optional", "timeout_seconds", "retry", "verification_owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "deliverable": {"type": "string", "minLength": 1, "maxLength": 500},
          "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "output_contract": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "max_items"],
            "properties": {"kind": {"enum": ["json", "text", "files", "decision"]}, "max_items": {"type": "integer", "minimum": 1}}
          },
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "reads": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "writes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "resources": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "object", "additionalProperties": false, "required": ["name", "capacity"], "properties": {"name": {"type": "string", "minLength": 1}, "capacity": {"type": "integer", "minimum": 1}}}
          },
          "requires_approval": {"type": "boolean"},
          "external_effect": {"enum": ["none", "external_read", "external_write", "paid_call", "production"]},
          "optional": {"type": "boolean"},
          "timeout_seconds": {"type": "integer", "minimum": 1},
          "retry": {
            "type": "object", "additionalProperties": false,
            "required": ["max_attempts", "idempotent", "renew_approval"],
            "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 3}, "idempotent": {"type": "boolean"}, "renew_approval": {"type": "boolean"}}
          },
          "verification_owner": {"const": "coordinator"}
        }
      }
    }
  }
}
