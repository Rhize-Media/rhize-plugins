{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rhize-Media/rhize-plugins/rhize-ops/delegate.config.schema.json",
  "title": "delegate-to-teammate configuration",
  "description": "Written by /rhize-ops:delegate-setup to $HOME/.claude/rhize-ops/delegate.config.json — outside this repo, never committed. This file is the schema/documentation only; it contains no real values. Supports multiple teammates: each key under `recipients` is a delegation target, `defaultRecipient` names which one to use when the delegator doesn't name a person. Legacy single-`recipient` configs (pre-0.4.0) are treated as `recipients: { default: <that recipient> }` — see the skill's SKILL.md for the compat shim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaultRecipient", "recipients", "jira", "slack", "projectMapping", "inferenceRules"],
  "properties": {
    "defaultRecipient": {
      "type": "string",
      "minLength": 1,
      "description": "Key into `recipients` used when the delegator doesn't name a specific teammate. Must match an existing key in `recipients`."
    },
    "recipients": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/recipient" },
      "description": "Map of recipient key -> recipient object. Keys are short lowercase identifiers (e.g. \"jane-doe\") used internally and matched against when a user names a teammate; the recipient's `name` field is matched case-insensitively against what the delegator types."
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "defaultLabels"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ready", "incomplete", "disabled"],
          "description": "ready = MCP connected and identifiers resolved+confirmed. incomplete = MCP absent or a required field unresolved — skip tracker-issue creation. disabled = deliberately opted out."
        },
        "cloudId": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "baseUrl": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https://[a-zA-Z0-9-]+\\.atlassian\\.net$"
        },
        "defaultLabels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "slack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "description": "Workspace-scoped Slack fields only. The notification channel is per-recipient — see `recipients.<key>.slack`.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ready", "incomplete", "disabled"],
          "description": "ready = MCP connected and workspace resolved+confirmed. incomplete = MCP absent or unresolved — skip chat notification. disabled = deliberately opted out."
        },
        "workspace": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "projectMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "internal", "service"],
      "properties": {
        "client": { "$ref": "#/$defs/projectList" },
        "internal": { "$ref": "#/$defs/projectList" },
        "service": { "$ref": "#/$defs/projectList" }
      }
    },
    "inferenceRules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "Ordered, most-specific-first. Last item should be a fallback like 'if ambiguous, ask the delegator to clarify'."
    }
  },
  "$defs": {
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email", "roleSummary"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "The recipient's full name. Matched case-insensitively when a delegator names a teammate." },
        "email": { "type": "string", "format": "email", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
        "jiraAccountId": {
          "type": ["string", "null"],
          "pattern": "^([0-9]+:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{24})$",
          "description": "Resolved via the Jira MCP's account lookup — required when jira.status is 'ready'. Matches both the legacy 'numeric:uuid' format (Server/Data Center-migrated accounts) and the 24-char hex format (Cloud-native accounts)."
        },
        "slackUserId": {
          "type": ["string", "null"],
          "pattern": "^U[A-Z0-9]{8,}$",
          "description": "Resolved via the Slack MCP's user search — required when slack.status is 'ready'."
        },
        "roleSummary": { "type": "string", "minLength": 1 },
        "slack": {
          "type": "object",
          "additionalProperties": false,
          "description": "This recipient's own notification channel — required when the top-level slack.status is 'ready'.",
          "properties": {
            "channel": { "type": ["string", "null"], "pattern": "^#[a-z0-9_-]+$" },
            "channelId": { "type": ["string", "null"], "pattern": "^C[A-Z0-9]{8,}$" }
          }
        },
        "technicalContext": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "knowsWell": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "learning": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "writingTone": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "projectList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "notes"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$" },
          "name": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "jira": { "properties": { "status": { "const": "ready" } } } } },
      "then": {
        "properties": {
          "jira": {
            "required": ["cloudId", "baseUrl"],
            "properties": {
              "cloudId": { "type": "string" },
              "baseUrl": { "type": "string" }
            }
          },
          "recipients": {
            "additionalProperties": {
              "required": ["jiraAccountId"],
              "properties": { "jiraAccountId": { "type": "string" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "slack": { "properties": { "status": { "const": "ready" } } } } },
      "then": {
        "properties": {
          "slack": {
            "required": ["workspace"],
            "properties": {
              "workspace": { "type": "string" }
            }
          },
          "recipients": {
            "additionalProperties": {
              "required": ["slackUserId", "slack"],
              "properties": {
                "slackUserId": { "type": "string" },
                "slack": {
                  "required": ["channel", "channelId"],
                  "properties": {
                    "channel": { "type": "string" },
                    "channelId": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "defaultRecipient": "jane-doe",
      "recipients": {
        "jane-doe": {
          "name": "Jane Doe",
          "email": "jane@example.com",
          "jiraAccountId": "5f8a1b2c3d4e5f6a7b8c9d0e",
          "slackUserId": "U01EXAMPLE1",
          "roleSummary": "Handles marketing and client site updates.",
          "slack": { "channel": "#jane-tasks", "channelId": "C01EXAMPLE1" },
          "technicalContext": {
            "knowsWell": ["Marketing campaigns"],
            "learning": ["Next.js basics"],
            "writingTone": "Direct and encouraging — explain the why, give exact commands."
          }
        }
      },
      "jira": {
        "status": "ready",
        "cloudId": "00000000-0000-0000-0000-000000000000",
        "baseUrl": "https://example.atlassian.net",
        "defaultLabels": ["delegated-by-example"]
      },
      "slack": { "status": "ready", "workspace": "example-workspace" },
      "projectMapping": {
        "client": [{ "key": "EX1", "name": "Example Client", "notes": "Website updates" }],
        "internal": [{ "key": "INT", "name": "Internal Tooling", "notes": "Internal dev work" }],
        "service": [{ "key": "SVC", "name": "Service Desk", "notes": "Support requests" }]
      },
      "inferenceRules": [
        "Marketing tasks -> default to the internal marketing project",
        "If ambiguous -> ask the delegator to clarify"
      ]
    }
  ]
}
