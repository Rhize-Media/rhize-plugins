{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhize.media/schemas/context-experiment-evidence-v1.schema.json",
  "title": "Rhize Context Experiment Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experimentId",
    "recordedAt",
    "taskOutcome",
    "packUseObserved",
    "validationIds",
    "armsExecuted",
    "armsSkipped"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "experimentId": {"$ref": "#/$defs/safeId"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "taskOutcome": {"enum": ["completed", "failed"]},
    "packUseObserved": {"type": "boolean"},
    "validationIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safeId"}
    },
    "armsExecuted": {"$ref": "#/$defs/arms"},
    "armsSkipped": {
      "type": "array",
      "items": {"$ref": "#/$defs/skippedArm"}
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "arm": {"enum": ["A", "B"]},
    "arms": {
      "type": "array",
      "items": {"$ref": "#/$defs/arm"},
      "uniqueItems": true,
      "maxItems": 2
    },
    "skippedArm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm", "reason"],
      "properties": {
        "arm": {"$ref": "#/$defs/arm"},
        "reason": {"$ref": "#/$defs/safeId"}
      }
    }
  }
}
