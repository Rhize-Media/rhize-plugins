{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhize.media/schemas/decision-registry-v1.schema.json",
  "title": "decision-registry-v1",
  "description": "Shipped default typed-decision registry (rhize-context-manager/catalog/decision-registry.json). Critical decisions may reach advise (with at least 10 critical cases in the gate) but never cosign; cosign is reachable only by advisory decisions with a deployable policy; advise is reachable if and only if the entry carries an `advise` gate config. Earned modes are never a default. Cross-field rules are enforced by the canonical stdlib validator in rhize-context-manager/scripts/typed_decisions/contract.py; this schema documents the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "decisions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "skill-fit",
          "workflow-fit",
          "procedure-pick",
          "devflow-next-action",
          "browser-qa-selection",
          "model-routing",
          "gsd-directive",
          "check-relaxation"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tier",
          "defaultMode",
          "reachableModes",
          "incumbent",
          "deployablePolicy",
          "instrument",
          "holdback",
          "latencyBudgetMs",
          "lambda",
          "endpoint",
          "model",
          "gates"
        ],
        "properties": {
          "tier": {
            "enum": [
              "advisory",
              "workflow",
              "critical"
            ]
          },
          "defaultMode": {
            "enum": [
              "off",
              "shadow"
            ]
          },
          "reachableModes": {
            "type": "array",
            "items": {
              "enum": [
                "off",
                "shadow",
                "advise",
                "cosign"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "incumbent": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,80}$"
          },
          "deployablePolicy": {
            "anyOf": [
              {
                "enum": [
                  "cosign-v1"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "instrument": {
            "anyOf": [
              {
                "const": "laya-choice-v1"
              },
              {
                "type": "null"
              }
            ]
          },
          "holdback": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              },
              {
                "type": "null"
              }
            ]
          },
          "latencyBudgetMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 100,
                "maximum": 5000
              },
              {
                "type": "null"
              }
            ]
          },
          "lambda": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "endpoint": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^http://(127\\.0\\.0\\.1|\\[::1\\]):\\d{2,5}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "anyOf": [
              {
                "const": "typed-decisions"
              },
              {
                "type": "null"
              }
            ]
          },
          "gates": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "advise": {
            "anyOf": [
              {
                "$ref": "#/$defs/advise"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "tier": {
                  "const": "critical"
                }
              }
            },
            "then": {
              "properties": {
                "reachableModes": {
                  "items": {
                    "enum": [
                      "off",
                      "shadow",
                      "advise"
                    ]
                  }
                },
                "advise": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "minCriticalCases": {
                          "minimum": 10
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "reachableModes": {
                  "contains": {
                    "const": "advise"
                  }
                }
              },
              "required": [
                "reachableModes"
              ]
            },
            "then": {
              "required": [
                "advise"
              ],
              "properties": {
                "advise": {
                  "type": "object"
                }
              }
            },
            "else": {
              "properties": {
                "advise": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "advise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "gate",
        "instrument",
        "holdback",
        "minCohort",
        "minCriticalCases",
        "alphaBase",
        "minCoverage",
        "demote"
      ],
      "properties": {
        "policy": {
          "const": "advise-v1"
        },
        "gate": {
          "const": "majority-baseline"
        },
        "instrument": {
          "enum": [
            "typed-advice-v1",
            "laya-choice-v1"
          ]
        },
        "holdback": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "minCohort": {
          "type": "integer",
          "minimum": 20
        },
        "minCriticalCases": {
          "type": "integer",
          "minimum": 0
        },
        "alphaBase": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.2
        },
        "minCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "demote": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "freshLabels",
            "window",
            "consecutive"
          ],
          "properties": {
            "freshLabels": {
              "type": "integer",
              "minimum": 5
            },
            "window": {
              "type": "integer",
              "minimum": 20
            },
            "consecutive": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
