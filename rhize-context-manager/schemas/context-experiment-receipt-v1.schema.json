{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhize.media/schemas/context-experiment-receipt-v1.schema.json",
  "title": "Rhize Context Experiment Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experimentId",
    "taskId",
    "capability",
    "status",
    "startedAt",
    "repoId",
    "repoName",
    "snapshot",
    "promptHash",
    "taskClass",
    "armsRequested",
    "armsExecuted",
    "armsSkipped",
    "liveVariant",
    "fallbackUsed",
    "metrics",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "experimentId": {
      "$ref": "#/$defs/safeId"
    },
    "taskId": {
      "$ref": "#/$defs/safeId"
    },
    "capability": {
      "enum": ["localRetrieval", "mgrep", "compiledContext"]
    },
    "status": {
      "enum": ["pending", "completed", "incomplete", "failed"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "repoId": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "repoName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "not": {
        "pattern": "^/"
      }
    },
    "snapshot": {
      "$ref": "#/$defs/safeId"
    },
    "promptHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "taskClass": {
      "enum": [
        "implementation",
        "diagnosis",
        "impact_analysis",
        "review",
        "deterministic_lookup",
        "operations",
        "unknown"
      ]
    },
    "armsRequested": {
      "$ref": "#/$defs/arms"
    },
    "armsExecuted": {
      "$ref": "#/$defs/arms"
    },
    "armsSkipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arm", "reason"],
        "properties": {
          "arm": {
            "$ref": "#/$defs/arm"
          },
          "reason": {
            "$ref": "#/$defs/safeId"
          }
        }
      }
    },
    "liveVariant": {
      "$ref": "#/$defs/arm"
    },
    "shadowVariant": {
      "anyOf": [
        {
          "$ref": "#/$defs/arm"
        },
        {
          "type": "null"
        }
      ]
    },
    "fallbackUsed": {
      "type": "boolean"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "variant", "role", "evidence"],
        "properties": {
          "name": {
            "$ref": "#/$defs/safeId"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "$ref": "#/$defs/safeId"
          },
          "variant": {
            "$ref": "#/$defs/arm"
          },
          "role": {
            "enum": ["live", "shadow"]
          },
          "evidence": {
            "enum": ["measured", "estimated", "human_judgment"]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500,
        "not": {
          "pattern": "^/"
        }
      }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "arm": {
      "enum": ["A", "B"]
    },
    "arms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/arm"
      },
      "uniqueItems": true,
      "maxItems": 2
    }
  }
}
