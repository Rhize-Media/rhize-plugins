{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhize.media/schemas/knowledge-graph-core-v1.schema.json",
  "title": "Rhize governed knowledge graph compilation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "ontologyChecksum", "artifactHash", "manifestHash", "tenantKey", "namespaceKey", "corpusKey", "sourceRevision", "compilationId", "records", "relationships", "rejections"],
  "properties": {
    "contractVersion": {"const": 1},
    "ontologyChecksum": {"$ref": "#/$defs/hash"},
    "artifactHash": {"$ref": "#/$defs/hash"},
    "manifestHash": {"$ref": "#/$defs/hash"},
    "tenantKey": {"$ref": "#/$defs/hash"},
    "namespaceKey": {"$ref": "#/$defs/hash"},
    "corpusKey": {"$ref": "#/$defs/hash"},
    "sourceRevision": {"type": "string", "minLength": 1, "maxLength": 256},
    "compilationId": {"$ref": "#/$defs/hash"},
    "records": {"type": "array", "minItems": 1, "maxItems": 400000, "items": {"$ref": "#/$defs/record"}},
    "relationships": {"type": "array", "maxItems": 1000000, "items": {"$ref": "#/$defs/relationship"}},
    "rejections": {"type": "array", "maxItems": 300000, "items": {"$ref": "#/$defs/rejection"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "acl": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "sourceRevision", "sourceRefHash", "artifactHash", "extractorVersion", "recordedAt"],
      "properties": {
        "sourceId": {"$ref": "#/$defs/hash"}, "sourceRevision": {"type": "string", "minLength": 1, "maxLength": 256},
        "sourceRefHash": {"$ref": "#/$defs/hash"}, "sourceLocation": {"type": ["string", "null"], "maxLength": 512},
        "artifactHash": {"$ref": "#/$defs/hash"}, "extractorVersion": {"type": "string", "minLength": 1, "maxLength": 256},
        "recordedAt": {"type": "string", "format": "date-time", "maxLength": 64},
        "wrapperVersion": {"type": ["string", "null"], "maxLength": 256}, "buildCommit": {"type": ["string", "null"], "maxLength": 256},
        "modelId": {"type": ["string", "null"], "maxLength": 256}, "promptHash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["governedId", "recordType", "subtype", "acl", "sensitivity", "trust", "confidenceClass", "confidenceScore", "quarantined", "recordedAt", "properties", "provenance"],
      "properties": {
        "governedId": {"$ref": "#/$defs/hash"},
        "recordType": {"enum": ["Source", "Entity", "Claim", "Event", "Artifact", "Preference", "Compilation"]},
        "subtype": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "acl": {"$ref": "#/$defs/acl"}, "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
        "trust": {"enum": ["high", "medium", "low", "unverified"]},
        "confidenceClass": {"enum": ["EXTRACTED", "INFERRED", "AMBIGUOUS"]},
        "confidenceScore": {"type": "number", "minimum": 0, "maximum": 1}, "quarantined": {"type": "boolean"},
        "recordedAt": {"type": "string", "format": "date-time", "maxLength": 64},
        "properties": {"type": "object"}, "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["governedId", "relationshipType", "sourceId", "targetId", "acl", "trust", "confidenceClass", "confidenceScore", "quarantined", "recordedAt", "properties", "provenance"],
      "properties": {
        "governedId": {"$ref": "#/$defs/hash"}, "relationshipType": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
        "sourceId": {"$ref": "#/$defs/hash"}, "targetId": {"$ref": "#/$defs/hash"}, "acl": {"$ref": "#/$defs/acl"},
        "trust": {"enum": ["high", "medium", "low", "unverified"]}, "confidenceClass": {"enum": ["EXTRACTED", "INFERRED", "AMBIGUOUS"]},
        "confidenceScore": {"type": "number", "minimum": 0, "maximum": 1}, "quarantined": {"type": "boolean"},
        "recordedAt": {"type": "string", "format": "date-time", "maxLength": 64},
        "properties": {"type": "object"}, "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "rejection": {
      "type": "object", "additionalProperties": false, "required": ["kind", "index", "code"],
      "properties": {"kind": {"enum": ["node", "edge", "hyperedge", "codeReference"]}, "index": {"type": "integer", "minimum": 0}, "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}}
    }
  }
}
