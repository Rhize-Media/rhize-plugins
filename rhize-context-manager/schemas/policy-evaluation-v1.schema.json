{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhize.media/schemas/policy-evaluation-v1.schema.json",
  "title": "Rhize deterministic policy evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluationVersion", "evaluationId", "policyIdHash", "policyVersion", "policyDigest", "inputRefs", "result", "status", "evaluatedAt", "evaluatorVersion", "deterministic", "outputDigest"],
  "properties": {
    "evaluationVersion": {"const": 1},
    "evaluationId": {"$ref": "#/$defs/hash"},
    "policyIdHash": {"$ref": "#/$defs/hash"},
    "policyVersion": {"$ref": "#/$defs/ref"},
    "policyDigest": {"$ref": "#/$defs/hash"},
    "inputRefs": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "result": {"enum": ["allow", "deny", "review"]},
    "status": {"enum": ["reproduced", "failed", "stale"]},
    "evaluatedAt": {"type": "string", "format": "date-time", "maxLength": 64},
    "evaluatorVersion": {"$ref": "#/$defs/ref"},
    "deterministic": {"const": true},
    "outputDigest": {"$ref": "#/$defs/hash"},
    "errorCode": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{1,63}$"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}
  }
}
