{
  "name": "rhize-plan-viewer",
  "version": "1.0.0",
  "description": "Self-contained local viewer + static HTML exporter for the Rhize plan.mdx format. Renders any plan.mdx from any path; no Next.js, no hosted plan service.",
  "type": "module",
  "bin": {
    "rhize-plan": "./bin/rhize-plan.mjs"
  },
  "scripts": {
    "dev": "node bin/rhize-plan.mjs serve",
    "build": "node bin/rhize-plan.mjs build"
  },
  "dependencies": {
    "@mdx-js/react": "3.1.0",
    "@mdx-js/rollup": "3.1.0",
    "@vitejs/plugin-react": "4.3.4",
    "gray-matter": "4.0.3",
    "mermaid": "11.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "5.0.0",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
