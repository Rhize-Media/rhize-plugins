{
  "mcpServers": {
    "obsidian-mcp-server": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/mcp-secret-launcher.sh",
      "args": ["OBSIDIAN_API_KEY", "--", "npx", "obsidian-mcp-server"],
      "env": {
        "OBSIDIAN_BASE_URL": "https://127.0.0.1:27124/",
        "OBSIDIAN_VERIFY_SSL": "false",
        "OBSIDIAN_ENABLE_CACHE": "true"
      }
    }
  }
}
