{
  "schemaVersion": "1.1.0",
  "nodes": [
    {
      "id": "external:ecc-suggest-compact",
      "kind": "external",
      "name": "ecc pre:edit-write:suggest-compact hook",
      "description": "everything-claude-code's compact-suggestion hook, superseded in this repo by rhize-context-manager's context-window-monitor.js for sessions using a verified-model window table instead of sniffing the model id for a '[1m]' marker."
    },
    {
      "id": "external:skill-forge",
      "kind": "external",
      "name": "@rhize/skill-forge",
      "description": "npm CLI (Rhize-Media/skill-forge) providing the SkillOpt evolve/safety gate that refinement-pipeline's /skill-refine run step and third-party skill intake depend on."
    },
    {
      "id": "external:rhize-skill-cli",
      "kind": "external",
      "name": "rhize-skill CLI",
      "description": "Canonical Rhize-Media/procedural-memory runtime. The procedural-memory skill uses its registry-gated recall/run/promote/verify commands, while Functionize uses only its mining, inert proposal-generation, and review commands."
    },
    {
      "id": "external:humanizer-humanizer",
      "kind": "external",
      "name": "humanizer (humanizer plugin)",
      "description": "Third-party plugin whose SKILL.md sits at the plugin root (not under skills/*/SKILL.md), so it isn't inventoried as a skill node by build_local_skill_map.py's third-party scan; rewrites AI-sounding text to read more naturally."
    },
    {
      "id": "external:ecc-react-build-resolver",
      "kind": "external",
      "name": "ecc:react-build-resolver (agent)",
      "description": "everything-claude-code agent (not a skill — agents.json/agents/*.md aren't skill-map node kinds); fixes React/Vite/Next/webpack build failures."
    },
    {
      "id": "external:ecc-go-build-resolver",
      "kind": "external",
      "name": "ecc:go-build-resolver (agent)",
      "description": "everything-claude-code agent; fixes Go build/vet failures."
    },
    {
      "id": "external:ecc-rust-build-resolver",
      "kind": "external",
      "name": "ecc:rust-build-resolver (agent)",
      "description": "everything-claude-code agent; fixes cargo build/borrow-checker failures."
    },
    {
      "id": "external:ecc-kotlin-build-resolver",
      "kind": "external",
      "name": "ecc:kotlin-build-resolver (agent)",
      "description": "everything-claude-code agent; fixes Kotlin/Gradle build failures."
    },
    {
      "id": "external:ecc-java-build-resolver",
