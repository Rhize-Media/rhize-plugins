    },
    {
      "id": "tag:condition/build-failure",
      "kind": "tag",
      "description": "A build/compile step failed (bundler, compiler, or `npm run build`-style failure)"
    },
    {
      "id": "tag:condition/type-error",
      "kind": "tag",
      "description": "A static type check failed (tsc, mypy, or equivalent)"
    },
    {
      "id": "external:sentry-plugin",
      "kind": "external",
      "name": "sentry (sentry-plugin-marketplace)",
      "description": "Official Sentry plugin (sentry-instrument, sentry-workflow, sentry-debug-issue, sentry-feature-setup, sentry-get-started skills) providing general-purpose SDK setup and API reference. rhize-devflow's sentry-instrumentation skill covers only Rhize house conventions (captureException/startSpan/logger.fmt patterns, sensitive-data handling) on top of it."
    },
    {
      "id": "external:sanity-plugin",
      "kind": "external",
      "name": "sanity (sanity-agent-toolkit)",
      "description": "Official Sanity plugin (sanity-best-practices, content-modeling-best-practices, portable-text-serialization, seo-aeo-best-practices skills, plus deploy-schema/typegen commands) providing general Sanity API documentation. rhize-devflow's sanity-development skill covers only Rhize house conventions (named exports, SCREAMING_SNAKE_CASE queries, model-what-things-ARE) on top of it."
    },
    {
      "id": "external:ecc-browser-qa",
      "kind": "external",
      "name": "ecc:browser-qa (skill)",
      "description": "everything-claude-code's browser QA skill — the active browser specialist chrome-devtools-mcp defers general DevTools-protocol API documentation to. rhize-devflow's chrome-devtools-mcp skill supplies only the tool-name/parameter mechanics its own browser-qa command calls."
    },
    {
      "id": "external:superpowers-finishing-development-branch",
      "kind": "external",
      "name": "superpowers:finishing-a-development-branch (skill)",
      "description": "Maintained Superpowers branch-finishing resource supplying environment detection, detached-worktree handling, rejected-push safeguards, and cleanup mechanics. rhize-devflow's completed-branch-promotion adds the Rhize-specific authorized dev/main PR and deployment sequence."
    },
    {
      "id": "external:rhize-tasks-runtime",
      "kind": "external",
      "name": "rhize-tasks runtime (Rhize-Media/rhize-tasks)",
      "description": "Separate local-first planning service, installer, CLI, and Swift EventKit helper pinned by rhize-tasks/setup/manifest.json's 'rhize-tasks runtime' dependency. The rhize-tasks plugin ships no runtime code; every rhize-tasks skill drives this installed CLI/service/dashboard as its single planning authority."
    },
    {
      "id": "external:rhize-outreach-runtime",
      "kind": "external",
      "name": "rhize-outreach runtime (Rhize-Media/rhize-outreach)",
      "description": "Local-first operator UI and resumable selected-business workflow fetched at an immutable commit (rhize-outreach/setup/manifest.json's 'rhize-outreach runtime' dependency). Setup installs it; run, package, business and email review operate inside its UI and agent graph."
    },
    {
      "id": "external:defuddle-cli",
      "kind": "external",
      "name": "Defuddle CLI (npm: defuddle)",
      "description": "Command-line web-content extractor (`defuddle parse <url> --md`) that the obsidian-second-brain defuddle skill documents and drives."
    },
    {
      "id": "external:obsidian-app-cli",
      "kind": "external",
      "name": "Obsidian official CLI (v1.12.4+)",
      "description": "The `obsidian` command-line interface built into the Obsidian app (Settings > General > Command line interface); requires the app running. The obsidian-second-brain obsidian-cli skill documents and drives it."
    },
    {
      "id": "external:ecc-parallel-execution-optimizer",
      "kind": "external",
      "name": "ecc:parallel-execution-optimizer (skill)",
      "description": "everything-claude-code parallel-execution skill, consolidated (human-authorized 2026-08-30) into rhize-ops:parallel-agent-optimization, whose runtime never loads it. Attribution lives in rhize-ops/skills/SOURCES.md (provenance-only)."
    },
    {
      "id": "external:superpowers-dispatching-parallel-agents",
      "kind": "external",
      "name": "superpowers:dispatching-parallel-agents (skill)",
      "description": "Superpowers parallel-dispatch skill, consolidated (human-authorized 2026-08-30) into rhize-ops:parallel-agent-optimization, whose runtime never loads it. Attribution lives in rhize-ops/skills/SOURCES.md (provenance-only)."
    }
