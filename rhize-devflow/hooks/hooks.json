{
  "description": "rhize-devflow auto-wires one cross-harness workflow gate: material implementation/refactor prompts require a CodeGraph-or-recorded-fallback impact-map receipt before source edits, and reconciliation before commit/completion. The mutation and protected-file guards remain opt-in through setup/manifest.json.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/refactor_gate.py\" hook-prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/refactor_gate.py\" hook-write",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|exec_command|functions.exec",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/refactor_gate.py\" hook-command",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/refactor_gate.py\" hook-stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
