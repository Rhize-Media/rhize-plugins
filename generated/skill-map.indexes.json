  "remediation": {
    "build-failure": {
      "patterns": [
        "(?i)\\bbuild failed\\b",
        "(?i)\\bfailed to compile\\b",
        "(?i)\\bcompilation failed\\b",
        "(?i)\\bmodule not found\\b",
        "(?i)\\bwebpack\\b.*\\berror\\b"
      ],
      "skills": [
        "external:ecc-build-error-resolver",
        "external:ecc-cpp-build-resolver",
        "external:ecc-dart-build-resolver",
        "external:ecc-django-build-resolver",
        "external:ecc-go-build-resolver",
        "external:ecc-java-build-resolver",
        "external:ecc-kotlin-build-resolver",
        "external:ecc-react-build-resolver",
        "external:ecc-rust-build-resolver",
        "external:ecc-swift-build-resolver"
      ]
    },
    "lint-failure": {
      "patterns": [
        "(?i)\\b\\d+ problems? \\(\\d+ errors?",
        "(?i)\\beslint\\b.*\\berror\\b",
        "(?i)code style issues found",
        "(?i)\\bruff\\b.*\\berror\\b"
      ],
      "skills": []
    },
    "merge-conflict": {
      "patterns": [
        "(?i)\\bCONFLICT \\(.*\\):",
        "(?i)\\bautomatic merge failed\\b",
        "^<<<<<<< ",
        "(?i)\\bfix conflicts and then commit\\b"
      ],
      "skills": []
    },
    "test-failure": {
      "patterns": [
        "(?i)\\b\\d+ (failing|failed)\\b",
        "(?i)^\\s*FAIL\\b",
        "\\bAssertionError\\b",
        "(?i)\\btests? failed\\b",
        "(?i)\\bexpect\\(received\\)\\b"
      ],
      "skills": []
    },
    "type-error": {
      "patterns": [
        "\\berror TS\\d+\\b",
        "(?i)\\btype error\\b",
        "(?i)\\bcannot find name '",
        "(?i)\\bis not assignable to type\\b",
        "\\bmypy\\b.*\\berror\\b"
      ],
      "skills": [
        "external:ecc-build-error-resolver"
      ]
    }
  },
