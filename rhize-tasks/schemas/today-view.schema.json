{
  "$schema": "https://rhize.media/schemas/rhize-tasks/format-assertion-2020-12.meta.json",
  "title": "TodayViewV1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "planRevision", "generatedAt", "timeline", "currentBlock", "nextBlock", "capacity", "carryovers", "approvals", "reconciliation", "opportunities", "warnings", "connectors", "paused", "degraded"],
  "properties": {"schemaVersion": {"const": 1}, "planRevision": {"type": "integer", "minimum": 1}, "generatedAt": {"type": "string", "format": "date-time"}, "timeline": {"type": "array", "items": {"$ref": "#/$defs/timelineItem"}}, "currentBlock": {"anyOf": [{"$ref": "#/$defs/timelineItem"}, {"type": "null"}]}, "nextBlock": {"anyOf": [{"$ref": "#/$defs/timelineItem"}, {"type": "null"}]}, "capacity": {"type": "object", "additionalProperties": false, "required": ["availableMinutes", "plannedMinutes", "bufferMinutes", "risk"], "properties": {"availableMinutes": {"type": "integer", "minimum": 0}, "plannedMinutes": {"type": "integer", "minimum": 0}, "bufferMinutes": {"type": "integer", "minimum": 0}, "risk": {"enum": ["normal", "tight", "over"]}}}, "carryovers": {"type": "array", "items": {"$ref": "#/$defs/carryover"}}, "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}}, "reconciliation": {"type": "array", "items": {"$ref": "#/$defs/reconciliation"}}, "opportunities": {"type": "array", "items": {"$ref": "#/$defs/opportunity"}}, "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}, "connectors": {"type": "object", "additionalProperties": false, "required": ["jira", "calendar", "reminders", "slack"], "properties": {"jira": {"$ref": "#/$defs/connector"}, "calendar": {"$ref": "#/$defs/connector"}, "reminders": {"$ref": "#/$defs/connector"}, "slack": {"$ref": "#/$defs/connector"}}}, "paused": {"type": "boolean"}, "degraded": {"type": "boolean"}},
  "$defs": {"text": {"type": "string", "minLength": 1}, "timelineItem": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "start", "end", "redacted"], "properties": {"id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["focus", "fixed", "outside", "break"]}, "start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}, "title": {"$ref": "#/$defs/text"}, "redacted": {"type": "boolean"}, "taskId": {"$ref": "#/$defs/text"}}}, "carryover": {"type": "object", "additionalProperties": false, "required": ["taskId", "title", "missCount", "reason", "resolution"], "properties": {"taskId": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"}, "missCount": {"type": "integer", "minimum": 1}, "reason": {"$ref": "#/$defs/text"}, "resolution": {"enum": ["rescheduled", "needs_diagnosis", "decision_required"]}}}, "approval": {"type": "object", "additionalProperties": false, "required": ["operationId", "kind", "title", "reason"], "properties": {"operationId": {"$ref": "#/$defs/text"}, "kind": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}}}, "reconciliation": {"type": "object", "additionalProperties": false, "required": ["operationId", "kind", "targetSystem", "reason"], "properties": {"operationId": {"$ref": "#/$defs/text"}, "kind": {"$ref": "#/$defs/text"}, "targetSystem": {"enum": ["jira", "calendar", "reminders", "local"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$"}}}, "opportunity": {"type": "object", "additionalProperties": false, "required": ["taskId", "title", "priority", "fit", "estimateMinutes", "rationale", "impact"], "properties": {"taskId": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"}, "priority": {"enum": ["urgent", "high", "normal", "low"]}, "fit": {"type": "number", "minimum": 0, "maximum": 1}, "estimateMinutes": {"type": "integer", "minimum": 1}, "rationale": {"$ref": "#/$defs/text"}, "impact": {"$ref": "#/$defs/text"}}}, "warning": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"$ref": "#/$defs/text"}, "message": {"$ref": "#/$defs/text"}, "taskId": {"$ref": "#/$defs/text"}}}, "connector": {"type": "object", "additionalProperties": false, "required": ["status", "freshAt", "staleMinutes"], "properties": {"status": {"enum": ["healthy", "degraded", "offline", "revoked"]}, "freshAt": {"type": ["string", "null"], "format": "date-time"}, "staleMinutes": {"type": "integer", "minimum": 0}}}}
}
