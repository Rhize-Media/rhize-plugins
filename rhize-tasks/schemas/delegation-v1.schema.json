{
  "$schema": "https://rhize.media/schemas/rhize-tasks/format-assertion-2020-12.meta.json", "title": "DelegationV1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "workspaceId", "channelId", "senderId", "delegationId", "ingestionKey", "title", "dueDate", "priority", "jira", "state", "planningLane", "approval", "schedulable"],
  "properties": {"schemaVersion": {"const": 1}, "workspaceId": {"type": "string", "minLength": 1}, "channelId": {"type": "string", "minLength": 1}, "senderId": {"type": "string", "minLength": 1}, "delegationId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "ingestionKey": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "dueDate": {"type": "string", "format": "date"}, "priority": {"enum": ["urgent", "high", "normal", "low"]}, "jira": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"enum": ["url", "key", "needs_jira"]}, "value": {"type": ["string", "null"]}}, "allOf": [{"if": {"properties": {"kind": {"const": "url"}}, "required": ["kind"]}, "then": {"properties": {"value": {"type": "string", "format": "uri", "pattern": "^https://(?![^/?#]*@)[^\\s/?#]+(?:[/?#]|$)"}}}}, {"if": {"properties": {"kind": {"const": "key"}}, "required": ["kind"]}, "then": {"properties": {"value": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*$"}}}}, {"if": {"properties": {"kind": {"const": "needs_jira"}}, "required": ["kind"]}, "then": {"properties": {"value": {"type": "null"}}}}]}, "state": {"enum": ["jira_linked", "needs_jira"]}, "planningLane": {"const": "provisional"}, "approval": {"const": "required"}, "schedulable": {"const": false}}
}
