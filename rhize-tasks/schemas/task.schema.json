{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "sourceType", "lane", "title", "projectKey", "issueType", "assigneeAccountId", "priority", "dueDate", "status", "terminal", "blocked", "dependencyRisk", "remainingMinutes", "explicitEstimateMinutes", "competencies", "manualLock", "carryoverCount", "sourceRevision"],
  "properties": {
    "schemaVersion": {"const": 1}, "id": {"$ref": "#/$defs/nonempty"}, "sourceType": {"enum": ["jira", "delegation"]}, "lane": {"enum": ["owned", "opportunity", "provisional"]}, "title": {"$ref": "#/$defs/nonempty"}, "projectKey": {"$ref": "#/$defs/nonempty"}, "issueType": {"$ref": "#/$defs/nonempty"}, "assigneeAccountId": {"type": ["string", "null"], "minLength": 1}, "priority": {"enum": ["urgent", "high", "normal", "low"]}, "dueDate": {"type": ["string", "null"], "format": "date"}, "status": {"$ref": "#/$defs/nonempty"}, "terminal": {"type": "boolean"}, "blocked": {"type": "boolean"}, "dependencyRisk": {"type": "integer", "minimum": 0, "maximum": 5}, "remainingMinutes": {"type": ["integer", "null"], "minimum": 1, "maximum": 10080}, "explicitEstimateMinutes": {"type": ["integer", "null"], "minimum": 1, "maximum": 10080}, "competencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}, "manualLock": {"type": "boolean"}, "carryoverCount": {"type": "integer", "minimum": 0}, "sourceRevision": {"$ref": "#/$defs/nonempty"}, "jiraKey": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*$"}, "jiraUrl": {"type": "string", "format": "uri", "pattern": "^https://"}, "delegationId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "description": {"type": "string"}, "estimate": {"$ref": "#/$defs/estimate"}
  },
  "allOf": [{"if": {"properties": {"sourceType": {"const": "jira"}}, "required": ["sourceType"]}, "then": {"anyOf": [{"required": ["jiraKey"]}, {"required": ["jiraUrl"]}]}}, {"if": {"properties": {"sourceType": {"const": "delegation"}}, "required": ["sourceType"]}, "then": {"required": ["delegationId"]}}],
  "$defs": {"nonempty": {"type": "string", "minLength": 1}, "estimate": {"type": "object", "additionalProperties": false, "required": ["minutes", "source", "confidence", "rationale", "confirmedAt", "requiresApproval"], "properties": {"minutes": {"type": "integer", "minimum": 1, "maximum": 10080}, "source": {"enum": ["jira_remaining", "explicit", "history", "inferred", "agent_assisted"]}, "confidence": {"enum": ["high", "medium", "low"]}, "rationale": {"$ref": "#/$defs/nonempty"}, "confirmedAt": {"type": ["string", "null"], "format": "date-time"}, "requiresApproval": {"type": "boolean"}}}}
}
