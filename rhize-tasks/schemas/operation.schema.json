{
  "$schema": "https://rhize.media/schemas/rhize-tasks/format-assertion-2020-12.meta.json",
  "title": "OperationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "planRevision", "kind", "targetSystem", "targetId", "payload", "idempotencyKey", "approval", "preconditionRevision", "retryState", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1}, "id": {"$ref": "#/$defs/nonempty"}, "planRevision": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["reminder_upsert", "reminder_complete", "reminder_delete", "calendar_upsert", "calendar_delete", "jira_assign", "jira_transition", "jira_comment", "jira_create", "provisional_link", "urgent_displacement", "scope_expand"]},
    "targetSystem": {"enum": ["jira", "calendar", "reminders", "local"]}, "targetId": {"type": ["string", "null"], "minLength": 1}, "payload": {"type": "object"},
    "idempotencyKey": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "approval": {"enum": ["required", "approved", "applied", "rejected"]}, "preconditionRevision": {"type": ["string", "null"], "minLength": 1},
    "retryState": {"enum": ["pending", "safe_retry", "reconciliation_required", "applied", "failed"]}, "createdAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "reminder_upsert"}}, "required": ["kind"]}, "then": {"properties": {"targetSystem": {"const": "reminders"}, "payload": {"$ref": "#/$defs/reminderUpsert"}}}},
    {"if": {"properties": {"kind": {"const": "reminder_complete"}}, "required": ["kind"]}, "then": {"properties": {"targetSystem": {"const": "reminders"}, "payload": {"$ref": "#/$defs/reminderComplete"}}}},
    {"if": {"properties": {"kind": {"const": "reminder_delete"}}, "required": ["kind"]}, "then": {"properties": {"targetSystem": {"const": "reminders"}, "payload": {"$ref": "#/$defs/empty"}}}},
    {"if": {"properties": {"kind": {"const": "calendar_upsert"}}, "required": ["kind"]}, "then": {"properties": {"targetSystem": {"const": "calendar"}, "targetId": {"type": ["string", "null"], "minLength": 1}, "payload": {"$ref": "#/$defs/calendarUpsert"}}}, "else": {"properties": {"targetId": {"$ref": "#/$defs/nonempty"}}}},
    {"if": {"properties": {"kind": {"const": "calendar_delete"}}, "required": ["kind"]}, "then": {"properties": {"targetSystem": {"const": "calendar"}, "payload": {"$ref": "#/$defs/empty"}}}},
    {"if": {"properties": {"kind": {"const": "jira_assign"}}, "required": ["kind"]}, "then": {"properties": {"targetSystem": {"const": "jira"}, "payload": {"$ref": "#/$defs/jiraAssign"}}}},
    {"if": {"properties": {"kind": {"const": "jira_transition"}}, "required": ["kind"]}, "then": {"properties": {"targetSystem": {"const": "jira"}, "payload": {"$ref": "#/$defs/jiraTransition"}}}},
    {"if": {"properties": {"kind": {"const": "jira_comment"}}, "required": ["kind"]}, "then": {"properties": {"targetSystem": {"const": "jira"}, "payload": {"$ref": "#/$defs/jiraComment"}}}},
    {"if": {"properties": {"kind": {"const": "jira_create"}}, "required": ["kind"]}, "then": {"properties": {"targetSystem": {"const": "jira"}, "payload": {"$ref": "#/$defs/jiraCreate"}}}},
    {"if": {"properties": {"kind": {"const": "provisional_link"}}, "required": ["kind"]}, "then": {"properties": {"targetSystem": {"const": "local"}, "payload": {"$ref": "#/$defs/provisionalLink"}}}},
    {"if": {"properties": {"kind": {"const": "urgent_displacement"}}, "required": ["kind"]}, "then": {"properties": {"targetSystem": {"const": "local"}, "payload": {"$ref": "#/$defs/urgentDisplacement"}}}},
    {"if": {"properties": {"kind": {"const": "scope_expand"}}, "required": ["kind"]}, "then": {"properties": {"targetSystem": {"const": "local"}, "payload": {"$ref": "#/$defs/scopeExpand"}}}}
  ],
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1}, "empty": {"type": "object", "additionalProperties": false, "maxProperties": 0},
    "reminderUpsert": {"type": "object", "additionalProperties": false, "required": ["listId", "title", "dueAt", "notes", "externalId"], "properties": {"listId": {"$ref": "#/$defs/nonempty"}, "title": {"$ref": "#/$defs/nonempty"}, "dueAt": {"type": ["string", "null"], "format": "date-time"}, "notes": {"type": "string"}, "externalId": {"$ref": "#/$defs/nonempty"}}},
    "reminderComplete": {"type": "object", "additionalProperties": false, "required": ["completedAt"], "properties": {"completedAt": {"type": "string", "format": "date-time"}}},
    "calendarUpsert": {"type": "object", "additionalProperties": false, "required": ["calendarId", "title", "start", "end", "description", "externalId"], "properties": {"calendarId": {"$ref": "#/$defs/nonempty"}, "title": {"$ref": "#/$defs/nonempty"}, "start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}, "description": {"type": "string"}, "externalId": {"$ref": "#/$defs/nonempty"}}},
    "jiraAssign": {"type": "object", "additionalProperties": false, "required": ["accountId"], "properties": {"accountId": {"$ref": "#/$defs/nonempty"}}},
    "jiraTransition": {"type": "object", "additionalProperties": false, "required": ["transitionId", "comment"], "properties": {"transitionId": {"$ref": "#/$defs/nonempty"}, "comment": {"type": ["string", "null"]}}},
    "jiraComment": {"type": "object", "additionalProperties": false, "required": ["body"], "properties": {"body": {"$ref": "#/$defs/nonempty"}}},
    "jiraCreate": {"type": "object", "additionalProperties": false, "required": ["projectKey", "issueType", "title", "description", "dueDate", "priority"], "properties": {"projectKey": {"$ref": "#/$defs/nonempty"}, "issueType": {"$ref": "#/$defs/nonempty"}, "title": {"$ref": "#/$defs/nonempty"}, "description": {"type": "string"}, "dueDate": {"type": ["string", "null"], "format": "date"}, "priority": {"enum": ["urgent", "high", "normal", "low"]}}},
    "provisionalLink": {"type": "object", "additionalProperties": false, "required": ["delegationId", "jiraKey", "jiraUrl"], "properties": {"delegationId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "jiraKey": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*$"}, "jiraUrl": {"type": "string", "format": "uri", "pattern": "^https://(?![^/?#]*@)[^\\s/?#]+(?:[/?#]|$)"}}},
    "urgentDisplacement": {"type": "object", "additionalProperties": false, "required": ["displacedBlockIds", "replacementTaskId"], "properties": {"displacedBlockIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}, "replacementTaskId": {"$ref": "#/$defs/nonempty"}}},
    "scopeExpand": {"type": "object", "additionalProperties": false, "required": ["connector", "resourceIds"], "properties": {"connector": {"enum": ["jira", "calendar", "reminders", "slack"]}, "resourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}}}
  }
}
