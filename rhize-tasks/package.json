{
  "name": "rhize-tasks",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first planning for Rhize Jira work across Calendar and Reminders",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "validate": "node --input-type=module --eval \"for (const path of ['package.json', 'setup/manifest.json']) JSON.parse(await (await import('node:fs/promises')).readFile(path, 'utf8'))\""
  }
}
