{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "variant",
    "task_id",
    "started_at",
    "completed_at",
    "decision",
    "decision_reason",
    "lanes_planned",
    "agents",
    "tool_calls",
    "tool_calls_availability_reason",
    "tokens",
    "tokens_availability_reason",
    "required_checks",
    "completed_checks",
    "passed_checks",
    "collisions",
    "rework_events",
    "correctness_claimed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "variant": {"enum": ["baseline", "arm_a", "arm_b", "arm_ab"]},
    "task_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1},
    "decision": {"enum": ["parallel", "sequential", "gated"]},
    "decision_reason": {"type": "string", "minLength": 1},
    "lanes_planned": {"type": "integer", "minimum": 0},
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role", "write_territory", "started_at", "completed_at", "status"],
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string"},
          "write_territory": {"type": "array", "items": {"type": "string"}},
          "started_at": {"type": ["string", "null"]},
          "completed_at": {"type": ["string", "null"]},
          "status": {"enum": ["completed", "failed", "interrupted"]}
        }
      }
    },
    "tool_calls": {"type": ["integer", "null"], "minimum": 0},
    "tool_calls_availability_reason": {"type": ["string", "null"]},
    "tokens": {
      "type": "object",
      "required": ["input", "output", "cache_read", "cache_write"],
      "properties": {
        "input": {"type": ["integer", "null"], "minimum": 0},
        "output": {"type": ["integer", "null"], "minimum": 0},
        "cache_read": {"type": ["integer", "null"], "minimum": 0},
        "cache_write": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "tokens_availability_reason": {"type": ["string", "null"]},
    "required_checks": {"type": "array", "items": {"type": "string"}},
    "completed_checks": {"type": "array", "items": {"type": "string"}},
    "passed_checks": {"type": "array", "items": {"type": "string"}},
    "collisions": {"type": "integer", "minimum": 0},
    "rework_events": {"type": "integer", "minimum": 0},
    "correctness_claimed": {"type": "boolean"}
  }
}
