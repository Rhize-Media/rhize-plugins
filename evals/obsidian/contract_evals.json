  },
  {
    "id": "contract-knowledge-compiler-preview-approval",
    "skill": "knowledge-compiler",
    "target_file": "obsidian-second-brain/skills/knowledge-compiler/SKILL.md",
    "assertions": [
      {"type": "regex", "value": "`preview` is the normal synthesis boundary", "name": "Uses preview boundary"},
