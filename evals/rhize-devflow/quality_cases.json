[
  {
    "id": "quality-check-exact-verdict-vocabulary",
    "target_file": "rhize-devflow/commands/check.md",
    "assertions": [
      {"type": "contains", "value": "`PASS`", "name": "Declares PASS"},
      {"type": "contains", "value": "`PASS_WITH_WARNINGS`", "name": "Declares PASS_WITH_WARNINGS"},
      {"type": "contains", "value": "`BLOCKED`", "name": "Declares BLOCKED"}
    ]
  },
  {
    "id": "quality-check-evidence-table-presence",
    "target_file": "rhize-devflow/commands/check.md",
    "assertions": [
      {
        "type": "regex",
        "value": "\\|\\s*Gate\\s*\\|\\s*Command run\\s*\\|\\s*Result\\s*\\|\\s*Evidence\\s*\\|",
        "name": "Evidence table header present"
      }
    ]
  },
  {
    "id": "quality-check-safety-no-external-mutation",
    "target_file": "rhize-devflow/commands/check.md",
    "assertions": [
      {"type": "contains", "value": "No commit, push, PR, deploy", "name": "Safety section prohibits commit/push/PR/deploy"},
      {"type": "contains", "value": "external mutation", "name": "Names 'external mutation' explicitly"}
    ]
  },
  {
    "id": "quality-check-scope-preservation",
    "target_file": "rhize-devflow/commands/check.md",
    "assertions": [
      {"type": "contains", "value": "Select checks from exactly two sources", "name": "Checks selected from exactly two named sources"},
      {"type": "contains", "value": "never select a check because", "name": "Prohibits selecting checks from prose/README/commit messages"}
    ]
  },
  {
    "id": "quality-review-exact-verdict-vocabulary",
    "target_file": "rhize-devflow/commands/review.md",
    "assertions": [
      {"type": "contains", "value": "`PASS`", "name": "Declares PASS"},
      {"type": "contains", "value": "`FAIL_WITH_FIXABLE_GAPS`", "name": "Declares FAIL_WITH_FIXABLE_GAPS"},
      {"type": "contains", "value": "`FAIL_REQUIRES_HUMAN`", "name": "Declares FAIL_REQUIRES_HUMAN"}
    ]
  },
  {
    "id": "quality-review-evidence-table-presence",
    "target_file": "rhize-devflow/commands/review.md",
    "assertions": [
      {
        "type": "regex",
        "value": "\\|\\s*Finding\\s*\\|\\s*File\\s*\\|\\s*Severity\\s*\\|\\s*Suggested fix owner\\s*\\|",
        "name": "Findings table header present"
      }
    ]
  },
  {
    "id": "quality-review-safety-no-external-mutation",
    "target_file": "rhize-devflow/commands/review.md",
    "assertions": [
      {"type": "contains", "value": "never commits, pushes, merges, deploys", "name": "Core Contract prohibits commit/push/merge/deploy"},
      {"type": "contains", "value": "no external mutation", "name": "Names 'no external mutation' explicitly"}
    ]
  },
  {
    "id": "quality-review-scope-preservation",
    "target_file": "rhize-devflow/commands/review.md",
    "assertions": [
      {"type": "contains", "value": "Preserve accepted product decisions as constraints", "name": "Preserves accepted product decisions as constraints"},
      {"type": "contains", "value": "do not relitigate scope", "name": "Reviewers do not relitigate scope"}
    ]
  },
  {
    "id": "quality-simplify-exact-boundary-and-no-op",
    "target_file": "rhize-devflow/skills/simplify/SKILL.md",
    "assertions": [
      {"type": "contains", "value": "Resolve the exact boundary first", "name": "Resolves exact review boundary"},
      {"type": "contains", "value": "well-supported no-op", "name": "Accepts evidence-backed no-op"}
    ]
  },
  {
    "id": "quality-simplify-candidate-gate",
    "target_file": "rhize-devflow/skills/simplify/SKILL.md",
    "assertions": [
      {"type": "contains", "value": "Apply a candidate only when every condition holds", "name": "Declares all-of candidate gate"},
      {"type": "contains", "value": "Authorization, tenancy, audit, concurrency, accessibility, and error contracts", "name": "Preserves critical contracts"}
    ]
  },
  {
    "id": "quality-simplify-react-contract",
    "target_file": "rhize-devflow/skills/simplify/SKILL.md",
    "assertions": [
      {"type": "contains", "value": "Derive render values directly from props and state", "name": "Forbids mirrored render state"},
      {"type": "contains", "value": "Use Effects to synchronize with external systems", "name": "Uses Effects only for external synchronization"}
    ]
  },
  {
    "id": "quality-simplify-authority-boundary",
    "target_file": "rhize-devflow/skills/simplify/SKILL.md",
    "assertions": [
      {"type": "contains", "value": "No extra release authority", "name": "Separates simplification from release authority"},
      {"type": "contains", "value": "commit, push, merge, deploy, migrate data", "name": "Names prohibited release mutations"}
    ]
  },
  {
    "id": "quality-promotion-authority-and-overrides",
    "target_file": "rhize-devflow/skills/completed-branch-promotion/SKILL.md",
    "assertions": [
      {"type": "contains", "value": "manual-push repository", "name": "Handles explicit manual-push authorization"},
      {"type": "contains", "value": "An explicit narrower instruction wins", "name": "Preserves explicit sequence overrides"},
      {"type": "contains", "value": "does not independently authorize a production data migration", "name": "Does not broaden external mutation authority"}
    ]
  },
  {
    "id": "quality-promotion-dev-and-devless-flows",
    "target_file": "rhize-devflow/skills/completed-branch-promotion/SKILL.md",
    "assertions": [
      {"type": "contains", "value": "task branch -> PR -> `main`", "name": "Defines dev-less protected-main flow"},
      {"type": "contains", "value": "Open a PR from the task branch to `dev`", "name": "Defines task-to-dev PR"},
      {"type": "contains", "value": "\"Push to main\" never means a raw", "name": "Rejects raw protected-main push"}
    ]
  },
  {
    "id": "quality-promotion-dirty-diverged-and-failed-gates",
    "target_file": "rhize-devflow/skills/completed-branch-promotion/SKILL.md",
    "assertions": [
      {"type": "contains", "value": "Preserve unrelated staged, unstaged, and untracked work", "name": "Protects unrelated dirty work"},
      {"type": "contains", "value": "non-fast-forward, diverged, or moved", "name": "Stops on remote divergence"},
      {"type": "contains", "value": "Any simplify, test, review, build, migration-preflight, or required browser gate that fails blocks promotion", "name": "Failed implementation gates block"},
      {"type": "contains", "value": "deployment, or smoke gate fails", "name": "Failed release gates block"}
    ]
  },
  {
    "id": "quality-promotion-vercel-author-safe-release",
    "target_file": "rhize-devflow/skills/completed-branch-promotion/SKILL.md",
    "assertions": [
      {"type": "contains", "value": "locally authored **empty release commit**", "name": "Uses a release-only author-safe commit"},
      {"type": "contains", "value": "tree is byte-for-byte identical to its parent", "name": "Proves release commit is content-neutral"},
      {"type": "contains", "value": "never rewrite authors or fabricate identity", "name": "Preserves commit identity integrity"}
    ]
  },
  {
    "id": "quality-test-evidence-classification-and-authority",
    "target_file": "rhize-devflow/skills/test-evidence/SKILL.md",
    "assertions": [
      {"type": "contains", "value": "behavior, artifact, or structural contract", "name": "Defines three contract classes"},
      {"type": "contains", "value": "never mutate or restore the user's live checkout", "name": "Protects live checkout"},
      {"type": "contains", "value": "distinct from `data-mutation-consistency`", "name": "Separates near-miss data mutation routing"},
      {"type": "contains", "value": "`cleanup_failed` returns `FAIL_REQUIRES_HUMAN`", "name": "Cleanup failure needs human recovery"}
    ]
  }
]
