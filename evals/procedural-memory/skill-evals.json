      "prompt": "What did we discuss last week about Skill Forge? Search past conversations.",
      "expected": []
    },
    {
      "id": "procedural-generic-negative",
      "prompt": "Write a one-line bash command that reverses a string.",
      "expected": []
    },
    {
      "id": "functionize-positive",
      "prompt": "I keep running the same gh CLI sequence. Functionize it into an inert redacted proposal, but do not register or run it.",
      "expected": ["functionize"]
    },
    {
      "id": "functionize-one-off-negative",
      "prompt": "Write a one-off wrapper around this curl command; there is no repeated CLI pattern to mine.",
      "expected": []
    },
    {
      "id": "functionize-promotion-collision",
      "prompt": "Promote this captured script into the procedural registry; do not Functionize it.",
      "expected": ["procedural-memory"]
    },
    {
      "id": "content-explicit-positive",
      "prompt": "Use the RHIZE Content Engine to regenerate our resource article as a local draft.",
      "expected": [
        "rhize-content-engine"
      ]
    },
    {
      "id": "content-ecc-negative",
      "prompt": "Use ECC content-engine to adapt this post for social channels.",
      "expected": []
    },
    {
      "id": "content-explanation-negative",
      "prompt": "Explain what a content engine is in one sentence.",
      "expected": []
    },
    {
      "id": "graph-build-positive",
      "prompt": "Build a reusable graph workflow with bounded dynamic research workers and named completion gates.",
      "expected": [
        "graph-workflow-builder"
      ]
    },
    {
      "id": "graph-knowledge-negative",
      "prompt": "Explain the difference between a knowledge graph and an execution DAG in two sentences; explanation only, no tools.",
      "expected": []
