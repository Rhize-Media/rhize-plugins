{
  "schema_version": 1,
  "skills": [
    {
      "id": "procedural-memory",
      "source": "procedural-memory/skills/procedural-memory/SKILL.md",
      "include_patterns": [
        "already .*?(?:proven|working).*?(?:tool|artifact)",
        "run the registry version",
        "promote (?:this|the) (?:captured )?script",
        "re-verify (?:an|the) artifact",
        "has this been automated before"
      ],
      "positive_cases": ["procedural-positive", "functionize-promotion-collision"],
      "negative_cases": ["procedural-memory-search-negative", "procedural-generic-negative"],
      "quality_contracts": [
        {"id": "digest-gate", "patterns": ["digest no longer matches", "refuse unconditionally"]},
        {"id": "trust-gate", "patterns": ["Never add `--approve-unreviewed`", "let the user decide"]},
        {"id": "retrieval-boundary", "patterns": ["does not retrieve past conversations", "claude-mem"]}
      ]
    },
    {
      "id": "functionize",
      "source": "procedural-memory/skills/functionize/SKILL.md",
      "include_patterns": [
        "functionize",
        "repeated cli (?:usage|pattern|sequence)",
        "mine repeated shell-history patterns",
        "generate (?:a )?(?:safe |inert )?wrapper proposal",
        "review a functionize candidate"
      ],
      "exclude_patterns": ["no repeated cli pattern", "do not functionize"],
      "positive_cases": ["functionize-positive"],
      "negative_cases": ["functionize-one-off-negative", "functionize-promotion-collision"],
      "quality_contracts": [
        {"id": "inert-proposal-review-modes", "patterns": ["exactly six modes", "mine", "generate", "review", "recipes", "recipe-review", "recipe-status", "Do not invoke `recipe-stage`, `promote`, `approve`, `verify` or `run` through Functionize", "requests documentation-only staging, hand off to the\\s+\\[`procedural-memory` skill\\]"]},
        {"id": "source-free-history", "patterns": ["redacts and aggregates", "never evaluated or\\s+executed"]},
        {"id": "proposal-boundary", "patterns": ["Stop at the proposal boundary", "grants no\\s+registration, trust, approval, promotion, verification, or execution authority"]}
      ]
    },
    {
      "id": "rhize-content-engine",
      "source": "procedural-memory/skills/rhize-content-engine/SKILL.md",
      "include_patterns": [
        "use (?:the )?rhize[ -]content[ -]engine"
      ],
      "exclude_patterns": [
        "\\becc\\b"
      ],
      "positive_cases": [
        "content-explicit-positive"
      ],
      "negative_cases": [
        "content-ecc-negative",
        "content-explanation-negative"
      ],
      "quality_contracts": [
        {
          "id": "scope-boundary",
          "patterns": [
            "local-draft",
            "Full publishing",
            "Unsupported"
          ]
        },
        {
          "id": "capture-boundary",
          "patterns": [
            "run bench-append --offline",
            "Failed/partial/unavailable"
          ]
        },
        {
          "id": "source-binding",
          "patterns": [
            "--source-sha256",
            "--run-id",
            "Never add `--approve-unreviewed`"
          ]
        },
        {"id": "reader-intent-brief", "patterns": ["reader question", "reader-focused-workflow.md", "before outlining"]},
        {"id": "reader-title-and-answer", "patterns": ["task or question", "direct answer", "internal project name"]},
        {"id": "clean-revision-copy", "patterns": ["rewrite the affected passage", "private editorial record", "necessary public correction"]},
        {"id": "derivative-reader-focus", "patterns": ["derivative", "same reader intent", "platform"]},
        {"id": "coordinator-editorial-gate", "patterns": ["every variant", "revise/hold", "graph.*schemas", "editorial-review.md", "validation-stage evidence", "partial/failed completion, never completed"]}
      ]
    },
    {
      "id": "graph-workflow-builder",
      "source": "procedural-memory/skills/graph-workflow-builder/SKILL.md",
      "include_patterns": [
        "build (?:a )?(?:reusable )?(?:graph workflow|execution graph)",
        "use graph-workflow-builder"
      ],
      "exclude_patterns": [
        "do not (?:invoke|build)",
        "knowledge graph"
      ],
      "positive_cases": [
        "graph-build-positive"
      ],
      "negative_cases": [
        "graph-knowledge-negative",
        "graph-simple-negative"
      ],
      "quality_contracts": [
        {
          "id": "build-boundary",
          "patterns": [
            "Builds and validates by default",
            "build-only request stops here",
            "Never add"
          ]
        },
        {
          "id": "dynamic-admission",
          "patterns": [
            "atomically",
            "completion barrier",
            "approved\\s+templates"
          ]
        },
        {
          "id": "verified-completion",
          "patterns": [
            "Missing evidence stays incomplete",
            "final acceptance gate",
            "Failed required work blocks dependents"
          ]
        },
        {
          "id": "subscription-worktrees",
          "patterns": [
            "subscription-native",
            "No metered API fallback",
            "Every parallel thread gets its own actual Git worktree",
            "Unknown token usage is null"
          ]
        }
      ]
    }
  ],
  "cases": [
    {
      "id": "procedural-positive",
      "prompt": "Is there already a proven working artifact for this deployment task? Check the registry first.",
      "expected": ["procedural-memory"]
    },
    {
