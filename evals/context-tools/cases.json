    {
      "id": "rhize-runner-collision-pressure",
      "repository": "rhize",
      "target": "rhize-context-manager/scripts/context_experiments/runner.py",
      "maxHops": 2,
      "maxTokens": 40000,
      "expectAccepted": false,
      "requiredEntries": [
        "rhize-context-manager/scripts/context_experiments/runner.py",
        "rhize-context-manager/scripts/context_experiments/models.py",
        "rhize-context-manager/scripts/context_experiments/eligibility.py"
      ]
    }
  ]
}
