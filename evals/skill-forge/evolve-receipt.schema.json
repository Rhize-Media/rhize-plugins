{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "comparison_id", "variant", "arm_actual", "digest", "repetition", "order_position", "metrics"],
  "properties": {
    "run_id": {"type": "string", "format": "uuid"},
    "comparison_id": {"type": "string", "format": "uuid"},
    "variant": {"enum": ["pre", "post"]},
    "arm_actual": {"enum": ["A", "B"]},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
    "order_position": {"type": "integer", "minimum": 1, "maximum": 2},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accuracy", "routing_precision", "routing_recall", "tokens_input", "tokens_output",
        "tokens_cache_read", "tokens_cache_write", "latency_ms", "tool_calls", "follow_up_reads",
        "corrections", "rework_events", "failures", "refusals"
      ]
    }
  }
}
