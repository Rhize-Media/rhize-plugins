{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "comparison_id", "skill", "variant", "arm_actual", "repetition",
    "order_position", "status", "started_at", "completed_at", "correctness", "routing", "tokens",
    "tokens_unavailable_reason", "latency_ms", "tool_calls", "tool_calls_unavailable_reason",
    "follow_up_reads", "corrections", "rework_events", "failures", "refusals"
  ],
  "properties": {
    "schema_version": {"const": "rhize-tasks-benefit-v1"},
    "run_id": {"type": "string", "format": "uuid"},
    "comparison_id": {"type": "string", "format": "uuid"},
    "skill": {"type": "string"},
    "variant": {"enum": ["baseline", "rhize"]},
    "arm_actual": {"enum": ["A", "B"]},
    "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
    "order_position": {"type": "integer", "minimum": 1, "maximum": 2},
    "status": {"enum": ["completed", "failed", "incomplete"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "correctness": {"type": "object", "required": ["passed", "total", "accuracy"], "additionalProperties": false},
    "routing": {"type": "object", "required": ["true_positives", "false_positives", "false_negatives", "precision", "recall"], "additionalProperties": false},
    "tokens": {"type": "object", "required": ["input", "output", "cache_read", "cache_write"], "additionalProperties": false},
    "tokens_unavailable_reason": {"type": ["string", "null"]},
    "latency_ms": {"type": ["integer", "null"]},
    "tool_calls": {"type": ["integer", "null"]},
    "tool_calls_unavailable_reason": {"type": ["string", "null"]},
    "follow_up_reads": {"type": ["integer", "null"]},
    "corrections": {"type": ["integer", "null"]},
    "rework_events": {"type": ["integer", "null"]},
    "failures": {"type": ["integer", "null"]},
    "refusals": {"type": ["integer", "null"]}
  }
}
